{
    "id": "chineseCalendar",
    "name": "Chinese Calendar",
    "description": "Display Chinese lunar calendar and holiday information in DankBar and DDash",
    "version": "2.0.0",
    "author": "xxyangyoulin",
    "type": "composite",
    "components": {
        "widget": "./CcalWidget.qml",
        "dashCard": "./CcalCard.qml"
    },
    "dash": {
        "card": {
            "title": "农历日历",
            "w": 4,
            "h": 4,
            "minW": 2,
            "minH": 2,
            "maxW": 6,
            "maxH": 6
        }
    },
    "icon": "calendar_month",
    "settings": "./CcalSettings.qml",
    "requires_dms": ">=1.7.0",
    "license": "MIT",
    "permissions": [
        "settings_read",
        "settings_write",
        "process",
        "network"
    ]
}
